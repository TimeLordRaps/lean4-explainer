# Vendored releases stay byte for byte what was published (tests check their checksums), on every platform:
# no line-ending conversion on checkout.
packages/reader/src/lean4_explainer_reader/vendor/katex/katex.min.* -text
packages/reader/src/lean4_explainer_reader/vendor/katex/LICENSE -text
packages/reader/src/lean4_explainer_reader/vendor/katex/fonts/** -text

# Hosted overlays are bound by SHA-256 in their manifest. Preserve their exact
# bytes when Git checks them out on Windows as well as Unix runners.
hosted/overlays/*.l4del -text
