@file APNOutputs/ErdosProblems/erdos_26.variants.tenenbaum.lean
@decl Erdos26.IsBehrend
-- L4DEL: title: A sequence of naturals $(a_i)$ is _Behrend_ if almost all integers are a multiple of some $a_i$
-- L4DEL: intuition: A sequence of naturals $(a_i)$ is _Behrend_ if almost all integers are a multiple of some $a_i$. In other words, if the set of multiples has natural density $1$.

@file APNOutputs/ErdosProblems/erdos_26.variants.tenenbaum.lean
@decl Erdos26.IsThick
-- L4DEL: title: A sequence of naturals $(a_i)$ is _thick_ if their sum of reciprocals diverges: $$ \sum_i \frac{1}{a_i} = \infty $$
-- L4DEL: intuition: A sequence of naturals $(a_i)$ is _thick_ if their sum of reciprocals diverges: $$ \sum_i \frac{1}{a_i} = \infty $$

@file APNOutputs/ErdosProblems/erdos_26.variants.tenenbaum.lean
@decl Erdos26.IsWeaklyBehrend
-- L4DEL: title: A sequence of naturals $(a_i)$ is _weakly Behrend_ with respect to $\varepsilon \in \mathbb{R}$ if at least $1 - \varepsilon$ density of all numbers are a multiple of $A$
-- L4DEL: intuition: A sequence of naturals $(a_i)$ is _weakly Behrend_ with respect to $\varepsilon \in \mathbb{R}$ if at least $1 - \varepsilon$ density of all numbers are a multiple of $A$.

@file APNOutputs/ErdosProblems/erdos_26.variants.tenenbaum.lean
